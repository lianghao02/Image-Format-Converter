<UserControl x:Class="PoliceImageToolkit.Views.LongScreenshotSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:PoliceImageToolkit.Models"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📱 手機長截圖分頁輔助" Style="{StaticResource Heading2TextStyle}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HelperTextStyle}" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📂 載入長截圖" Command="{Binding OpenImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="10"
                    AllowDrop="True" DragEnter="PreviewDrop_DragEnter" DragOver="PreviewDrop_DragOver" Drop="PreviewDrop_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,0,4,8">
                        <Grid>
                            <TextBlock Text="手機框預覽（拖曳、滾輪、↑／↓ 檢視）" Style="{StaticResource Heading3TextStyle}"/>
                            <TextBlock Text="{Binding SourceDimensions}" Style="{StaticResource HelperTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Background="#5C4314" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                                Visibility="{Binding HasLowResolutionWarning, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="⚠️ {Binding LowResolutionWarningMessage}" Style="{StaticResource HelperTextStyle}" Foreground="#FDE68A" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" MaxWidth="460" HorizontalAlignment="Center" Background="#000000" BorderBrush="#334155" BorderThickness="5" CornerRadius="28" ClipToBounds="True">
                        <Grid>
                            <ScrollViewer x:Name="LongImageScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="True" PreviewMouseLeftButtonDown="LongImageScroll_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="LongImageScroll_PreviewMouseMove" PreviewMouseLeftButtonUp="LongImageScroll_PreviewMouseLeftButtonUp"
                                          PreviewMouseWheel="LongImageScroll_PreviewMouseWheel" PreviewKeyDown="LongImageScroll_PreviewKeyDown">
                                <Grid x:Name="PreviewHost">
                                    <Image x:Name="LongPreviewImage" Source="{Binding SourceImage}" Stretch="Uniform"/>
                                    <Canvas x:Name="SplitOverlay" IsHitTestVisible="False"/>
                                </Grid>
                            </ScrollViewer>
                            <Grid Visibility="{Binding SourceImage, Converter={StaticResource NullToVisConverter}}">
                                <Border Background="#090E17" Opacity="0.95"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                    <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="手機長截圖工作台" Style="{StaticResource Heading3TextStyle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="可點擊載入，或直接拖曳 PNG／JPG 長截圖至此。" Style="{StaticResource HelperTextStyle}" TextAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="6,10,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PageSummary}" Style="{StaticResource HelperTextStyle}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="黃色斜線：前後頁固定重疊區（不會匯出）" Style="{StaticResource HelperTextStyle}" Foreground="#FBBF24" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="📁 檔案與匯出" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="📍 變更輸出路徑" Command="{Binding BrowseOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="📂 開啟輸出資料夾" Command="{Binding OpenOutputDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="檔名前綴（選填）" Style="{StaticResource FormLabelTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding FileNamePrefix, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="8,0,0,0" ToolTip="留白即輸出 001.png、002.png；填寫後例如 A113_001.png。"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="⚙️ Word 圖框比例與重疊設定" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="圖框寬（cm）" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox Text="{Binding FrameWidthCm, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="圖框高（cm）" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox Text="{Binding FrameHeightCm, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="重疊（mm）" Style="{StaticResource FormLabelTextStyle}"/>
                                <TextBox Text="{Binding OverlapMm, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="📄 分頁預覽清單" Style="{StaticResource Heading3TextStyle}" Margin="0,0,0,6"/>
                        <ListView Grid.Row="1" ItemsSource="{Binding Pages}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:LongScreenshotPage}">
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PageNumber, StringFormat=第 {0} 頁}" Style="{StaticResource FormLabelTextStyle}" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayRange}" Style="{StaticResource HelperTextStyle}"/>
                                            <TextBlock Text="{Binding DisplayOverlap}" Style="{StaticResource HelperTextStyle}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="PNG" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Button Grid.Row="3" Content="📤 匯出全部分頁 PNG" Command="{Binding ExportAllCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="18,10" FontSize="14" Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
